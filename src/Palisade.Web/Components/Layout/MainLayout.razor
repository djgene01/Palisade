@inherits LayoutComponentBase
@implements IDisposable
@inject FirewallState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<a href="@(new Uri(Nav.Uri).AbsolutePath)#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-surface focus:p-3">Skip to content</a>

@if (State.Status?.Simulated == true)
{
    <p class="border-b border-warn bg-warn-soft px-4 py-2 text-center text-sm font-semibold text-ink">
        Demo mode: this is a simulated network for trying the interface. Nothing here controls a real firewall.
    </p>
}

<div class="flex min-h-dvh flex-col md:flex-row">
    <header class="border-line bg-side md:sticky md:top-0 md:flex md:h-dvh md:w-60 md:shrink-0 md:flex-col md:overflow-y-auto md:border-r">
        <div class="px-4 py-4 md:px-5 md:pt-7">
            <a href="/" class="flex items-center gap-3 md:flex-col md:items-start md:gap-2">
                @* The mark: the palisade's pointed stakes, standing inside a shield. *@
                <svg class="h-10 w-9 shrink-0 text-brand md:h-16 md:w-14" viewBox="0 0 48 56" aria-hidden="true">
                    <path d="M24 2l20 7v17c0 14-8.5 23-20 28C12.500 49 4 40 4 26V9z" fill="var(--brand-soft)" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                    <path d="M13 22l4-5 4 5v18h-8zM20 18l4-5 4 5v24h-8zM27 22l4-5 4 5v18h-8z" fill="currentColor" stroke="var(--brand-soft)" stroke-width="1.5" stroke-linejoin="round" />
                </svg>
                <span>
                    <span class="block text-2xl font-extrabold leading-none tracking-tight text-ink">Palisade</span>
                    <span class="mt-1 block text-sm text-muted">Home firewall</span>
                </span>
            </a>
        </div>

        @if (Ready)
        {
            <nav aria-label="Main" class="flex gap-1 overflow-x-auto px-3 pb-3 md:flex-col md:overflow-visible md:pt-3">
                @foreach (var (href, label, icon) in Links)
                {
                    <NavLink href="@href" Match="@(href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="nav-link" ActiveClass="active">
                        <Icon Name="@icon" />@label
                    </NavLink>
                }
            </nav>
        }

        <div class="hidden border-t border-line px-3 py-4 md:mx-3 md:mt-4 md:block md:px-0">
            <button type="button" class="nav-link w-full cursor-pointer" @onclick="ToggleThemeAsync">
                <Icon Name="@(_dark ? "sun" : "moon")" />@(_dark ? "Use light colours" : "Use dark colours")
            </button>
            <form method="post" action="/logout">
                <button type="submit" class="nav-link w-full cursor-pointer"><Icon Name="sign-out" />Sign out</button>
            </form>
        </div>
    </header>

    <main id="main" class="mx-auto w-full min-w-0 max-w-6xl flex-1 px-4 pb-32 pt-4 md:px-10 md:pt-8">
        @if (State.Error is not null && State.Config is null)
        {
            <div role="alert" class="panel max-w-xl border-danger p-6">
                <h1 class="text-2xl font-bold" tabindex="-1">Can't reach the firewall service</h1>
                <p class="mt-2">The page loaded, but the part of Palisade that controls the network is not answering. Your network keeps running with the last saved rules.</p>
                <p class="mt-2 text-muted">@State.Error</p>
                <p class="mt-2 text-muted">On the firewall itself, <code>systemctl status palisade-agent</code> shows what went wrong.</p>
                <button type="button" class="btn btn-primary mt-4" @onclick="State.LoadAsync">Try again</button>
            </div>
        }
        else if (State.Config is null)
        {
            <p class="pt-10 text-muted" role="status">Loading your firewall's settings.</p>
        }
        else
        {
            @Body
        }

        <div class="mt-12 flex flex-wrap gap-2 border-t border-line pt-4 md:hidden">
            <button type="button" class="btn btn-quiet" @onclick="ToggleThemeAsync">@(_dark ? "Use light colours" : "Use dark colours")</button>
            <form method="post" action="/logout">
                <button type="submit" class="btn btn-quiet">Sign out</button>
            </form>
        </div>
    </main>
</div>

<ApplyGuard />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong on this page.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Dismiss</span>
</div>

@code {
    private static readonly (string Href, string Label, string Icon)[] Links =
    [
        ("/", "Overview", "home"), ("/devices", "Devices", "devices"), ("/filter", "Content filter", "shield"), ("/ports", "Open ports", "ports"),
        ("/rules", "Rules", "rules"), ("/network", "Network", "globe"), ("/advanced", "Advanced", "advanced"),
    ];

    private bool _dark;

    private bool Ready => State.Config?.SetupComplete == true;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await State.LoadAsync();
        SendToSetupIfNeeded();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dark = await JS.InvokeAsync<bool>("palisade.isDark");
        StateHasChanged();
    }

    private void SendToSetupIfNeeded()
    {
        var onWelcome = new Uri(Nav.Uri).AbsolutePath == "/welcome";
        if (State.Config is { SetupComplete: false } && !onWelcome) Nav.NavigateTo("/welcome");
    }

    private async Task ToggleThemeAsync() => _dark = await JS.InvokeAsync<bool>("palisade.toggleTheme");

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(SendToSetupIfNeeded);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
