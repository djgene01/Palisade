@page "/Error"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Something went wrong · Palisade</PageTitle>

<h1 class="text-3xl font-extrabold" tabindex="-1">Something went wrong</h1>
<p class="mt-2 text-lg text-muted">The page hit an error. Your network keeps running with the last saved rules.</p>
<a class="btn btn-primary mt-6" href="/">Go to the overview</a>
