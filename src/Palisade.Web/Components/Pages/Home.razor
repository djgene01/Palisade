@page "/"
@inherits StatePage
@using System.Globalization

<PageTitle>Overview · Palisade</PageTitle>

@{
    var status = State.Status;
    var protectedNow = status?.FirewallActive == true;
    var devices = State.Devices();
    var online = devices.Count(d => d.Online);
    var openPorts = Config.PortForwards.Count(f => f.Enabled);
    var rules = Config.Rules.Count(r => r.Enabled);
    var attention = Attention().ToList();
}

<h1 class="text-4xl font-extrabold leading-tight md:text-5xl" tabindex="-1">
    @(status is null ? "Checking your network" : protectedNow ? "Your network is protected." : "Protection is off.")
</h1>
<p class="mt-3 text-lg text-muted">
    @if (status is not null)
    {
        <span>@(status.InternetReachable ? "The internet is reachable." : "The internet is not reachable right now.") </span>
        <span>@(online == 0 ? "No devices are connected." : $"{Fmt.Plural(online, "device is", "devices are")} connected.")</span>
    }
</p>

@* The wall itself: internet on one side, the home network on the other, and what is let through in between. *@
<section aria-label="How traffic passes the firewall" class="panel mt-8 grid gap-0 overflow-hidden md:grid-cols-[1fr_auto_1fr]">
    <div class="p-5">
        <h2 class="font-bold text-muted">Internet side</h2>
        <p class="mt-1 text-2xl font-bold">@(State.Wan?.Addresses.FirstOrDefault()?.Split('/')[0] ?? "No address")</p>
        <p class="text-sm text-muted">Port @Config.WanInterface, @(State.Wan?.IsUp == true ? "cable connected" : "no cable detected")</p>
        <dl class="mt-4 flex gap-6">
            <div><dt class="text-sm text-muted">Coming in</dt><dd class="whitespace-nowrap text-lg font-bold">@Fmt.Rate(_downRate)</dd></div>
            <div><dt class="text-sm text-muted">Going out</dt><dd class="whitespace-nowrap text-lg font-bold">@Fmt.Rate(_upRate)</dd></div>
        </dl>
    </div>

    <div class="flex items-center gap-4 border-y border-line bg-sunk p-5 md:w-64 md:flex-col md:justify-center md:border-x md:border-y-0 md:text-center">
        <Stakes Count="7" Class="@($"h-12 shrink-0 {(protectedNow ? "text-pine" : "text-muted")}")" />
        <p>
            <a class="font-bold underline underline-offset-4" href="/ports">@Fmt.Plural(openPorts, "open port", "open ports")</a>
            <span class="text-muted">and</span>
            <a class="font-bold underline underline-offset-4" href="/rules">@Fmt.Plural(rules, "rule", "rules")</a>
            <span class="block text-sm text-muted">Everything else from the internet is turned away.</span>
        </p>
    </div>

    <div class="p-5">
        <h2 class="font-bold text-muted">Your network</h2>
        <p class="mt-1 text-2xl font-bold">@Config.LanAddress</p>
        <p class="text-sm text-muted">Port @Config.LanInterface, @(State.Lan?.IsUp == true ? "cable connected" : "no cable detected")</p>
        <p class="mt-4"><a class="font-bold underline underline-offset-4" href="/devices">@Fmt.Plural(online, "device", "devices") connected</a></p>
        @{ var offNow = AccessPlan.OffNow(Config.Access, DateTimeOffset.UtcNow, DateTime.Now).Count; }
        @if (offNow > 0)
        {
            <p class="mt-1 text-sm text-muted"><a class="font-bold text-ink underline underline-offset-4" href="/devices">@Fmt.Plural(offNow, "device has", "devices have")</a> the internet switched off right now.</p>
        }
        <p class="mt-1 text-sm text-muted">Content filter: <a class="font-bold text-ink underline underline-offset-4" href="/filter">@Fmt.FilterLevel(Config.Filter.Level)</a></p>
    </div>
</section>

<div class="mt-8 grid gap-8 lg:grid-cols-[3fr_2fr]">
    <section aria-labelledby="traffic-title">
        <h2 id="traffic-title" class="text-xl font-bold">Internet traffic over the last two minutes</h2>
        @if (_samples.Count < 2)
        {
            <p class="mt-3 text-muted" role="status">Measuring. The chart appears after a few seconds.</p>
        }
        else
        {
            var max = Math.Max(1, _samples.Max(s => Math.Max(s.Down, s.Up)));
            <svg viewBox="0 0 600 140" class="mt-3 w-full" role="img" aria-label="@($"Traffic chart. Peak {Fmt.Rate(max)}.")" preserveAspectRatio="none">
                <line x1="0" y1="139" x2="600" y2="139" stroke="var(--line)" stroke-width="1" />
                <polyline fill="none" stroke="var(--pine)" stroke-width="2.5" stroke-linejoin="round" points="@Points(s => s.Down, max)" />
                <polyline fill="none" stroke="var(--ochre)" stroke-width="2" stroke-dasharray="6 4" stroke-linejoin="round" points="@Points(s => s.Up, max)" />
            </svg>
            <p class="mt-2 flex flex-wrap gap-x-6 text-sm text-muted">
                <span><span class="mr-1 inline-block h-0.5 w-5 bg-pine align-middle"></span>Coming in</span>
                <span><span class="mr-1 inline-block w-5 border-t-2 border-dashed border-ochre align-middle"></span>Going out</span>
                <span>Peak @Fmt.Rate(max)</span>
            </p>
        }
    </section>

    <section aria-labelledby="attention-title">
        <h2 id="attention-title" class="text-xl font-bold">Needs your attention</h2>
        @if (attention.Count == 0)
        {
            <p class="mt-3 text-muted">Nothing right now. Palisade will list problems here when it finds them.</p>
        }
        else
        {
            <ul class="mt-3 space-y-3">
                @foreach (var (text, href, link) in attention)
                {
                    <li class="rounded-md border border-ochre bg-ochre-soft p-3">
                        @text <a class="font-bold underline underline-offset-4" href="@href">@link</a>
                    </li>
                }
            </ul>
        }
        @if (status is not null)
        {
            <p class="mt-6 text-sm text-muted">@status.Hostname has been running for @Fmt.Uptime(status.UptimeSeconds).</p>
        }
    </section>
</div>

@{
    var usage = Ranked();
    var top = usage.Take(8).ToList();
    var scale = Math.Max(1, top.Select(u => Math.Max(Measure(u, down: true), Measure(u, down: false))).DefaultIfEmpty(1).Max());
}
<section aria-labelledby="usage-title" class="mt-10">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
            <h2 id="usage-title" class="text-xl font-bold">Who is using the internet</h2>
            <p class="field-hint">@(_byRate ? "Ordered by speed over the last few seconds." : $"Ordered by total use {SinceText()}.")</p>
        </div>
        <div role="group" aria-label="Order the list by" class="flex gap-1">
            <button type="button" class="btn @(_byRate ? "" : "border-pine bg-pine-soft")" aria-pressed="@(_byRate ? "false" : "true")" @onclick="() => _byRate = false">Total</button>
            <button type="button" class="btn @(_byRate ? "border-pine bg-pine-soft" : "")" aria-pressed="@(_byRate ? "true" : "false")" @onclick="() => _byRate = true">Right now</button>
        </div>
    </div>

    @if (State.Usage is null)
    {
        <p class="mt-3 text-muted" role="status">Measuring.</p>
    }
    else if (top.Count == 0)
    {
        <p class="panel mt-3 p-4 text-muted">@(_byRate ? "No device is using the internet at this moment." : $"No device has used the internet {SinceText()}.")</p>
    }
    else
    {
        <ol class="panel mt-3 divide-y divide-line">
            @foreach (var u in top)
            {
                var device = devices.FirstOrDefault(d => d.Address == u.Address);
                var down = Measure(u, down: true);
                var up = Measure(u, down: false);
                <li class="grid items-center gap-x-5 gap-y-2 p-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto]">
                    <div class="min-w-0">
                        <p class="truncate font-bold">@(device?.Name ?? "Unknown device")</p>
                        <p class="text-sm text-muted">@u.Address</p>
                    </div>
                    <div aria-hidden="true" class="space-y-1">
                        <div class="h-2.5 rounded-sm bg-pine" style="width: @Width(down, scale)"></div>
                        <div class="h-1.5 rounded-sm bg-ochre" style="width: @Width(up, scale)"></div>
                    </div>
                    <p class="whitespace-nowrap text-sm sm:text-right">
                        <span class="block"><span class="font-bold">@Show(down)</span> <span class="text-muted">coming in</span></span>
                        <span class="block"><span class="font-bold">@Show(up)</span> <span class="text-muted">going out</span></span>
                    </p>
                </li>
            }
        </ol>
        @if (usage.Count > top.Count)
        {
            <p class="mt-2 text-sm text-muted">And @Fmt.Plural(usage.Count - top.Count, "more device", "more devices") using less than these.</p>
        }
    }
    <p class="mt-2 text-sm text-muted">Counts traffic between your devices and the internet. Totals start again from zero if the firewall restarts.</p>
</section>

@code {
    private bool _byRate;

    private double Measure(DeviceUsage u, bool down) => _byRate ? (down ? u.DownRate : u.UpRate) : (down ? u.DownBytes : u.UpBytes);

    private List<DeviceUsage> Ranked() => (State.Usage?.Devices ?? [])
        .Where(u => Measure(u, true) + Measure(u, false) > 0)
        .OrderByDescending(u => Measure(u, true) + Measure(u, false))
        .ToList();

    private string Show(double value) => _byRate ? Fmt.Rate(value) : Fmt.Bytes((long)value);

    // A sliver stays visible for anything above zero, so a quiet device is not mistaken for a silent one.
    private static string Width(double value, double scale) =>
        value <= 0 ? "0" : string.Create(CultureInfo.InvariantCulture, $"{Math.Max(1.5, value / scale * 100):0.#}%");

    private string SinceText()
    {
        if (State.Usage is not { } report) return "";
        if (DateTimeOffset.UtcNow - report.Since > TimeSpan.FromHours(23.9)) return "over the last 24 hours";
        var since = report.Since.ToLocalTime();
        return $"since {since.ToString("HH:mm", CultureInfo.InvariantCulture)}{(since.Date == DateTimeOffset.Now.Date ? "" : " yesterday")}";
    }

    private readonly List<(double Down, double Up)> _samples = [];
    private (long Rx, long Tx, DateTimeOffset At)? _last;
    private double _downRate, _upRate;
    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            do
            {
                await State.RefreshStatusAsync();
                if (State.Wan is { } wan)
                {
                    var now = DateTimeOffset.UtcNow;
                    if (_last is { } last && (now - last.At).TotalSeconds > 0.2)
                    {
                        var seconds = (now - last.At).TotalSeconds;
                        _downRate = Math.Max(0, (wan.RxBytes - last.Rx) / seconds);
                        _upRate = Math.Max(0, (wan.TxBytes - last.Tx) / seconds);
                        _samples.Add((_downRate, _upRate));
                        if (_samples.Count > 60) _samples.RemoveAt(0);
                    }
                    _last = (wan.RxBytes, wan.TxBytes, now);
                }
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) { }
    }

    private string Points(Func<(double Down, double Up), double> pick, double max) =>
        string.Join(' ', _samples.Select((s, i) => string.Create(CultureInfo.InvariantCulture,
            $"{i * 600.0 / 59:0.#},{136 - pick(s) / max * 130:0.#}")));

    private IEnumerable<(string Text, string Href, string Link)> Attention()
    {
        if (State.Status is not { } s) yield break;
        if (!s.FirewallActive) yield return ("The firewall rules are not loaded, so nothing is being filtered.", "/network", "Save your network settings again to reload them");
        if (!s.InternetReachable) yield return ("The firewall can't reach the internet. Check the cable on the internet port.", "/network", "See network settings");
        if (State.Wan is { IsUp: false }) yield return ($"No cable is detected on the internet port ({Config.WanInterface}).", "/network", "See network settings");
        if (Config.Dhcp.Enabled && !s.DhcpRunning) yield return ("Automatic addresses are switched on, but the service that hands them out has stopped.", "/network", "See network settings");
        if (!Config.Dhcp.Enabled) yield return ("Automatic addresses are off, so new devices must be set up by hand.", "/network", "Turn them on");
        if (Config.AllowManagementFromWan) yield return ("This firewall can be managed from the internet side. That is fine in a test lab and risky anywhere else.", "/network", "Review this setting");
    }

    public override void Dispose()
    {
        _cts.Cancel();
        base.Dispose();
    }
}
