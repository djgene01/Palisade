@page "/"
@inherits StatePage
@using System.Globalization

<PageTitle>Overview · Palisade</PageTitle>

@{
    var status = State.Status;
    var protectedNow = status?.FirewallActive == true;
    var devices = State.Devices();
    var online = devices.Count(d => d.Online);
    var openPorts = Config.PortForwards.Count(f => f.Enabled);
    var rules = Config.Rules.Count(r => r.Enabled);
    var attention = Attention().ToList();
    var wanUp = State.Wan?.IsUp == true;
    var lanUp = State.Lan?.IsUp == true;
}

<div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-4">
        <Icon Name="@(protectedNow ? "shield-check" : "shield")" Class="@($"h-14 w-14 md:h-20 md:w-20 {(protectedNow ? "text-ok" : "text-muted")}")" />
        <div>
            <h1 class="text-3xl font-extrabold leading-tight md:text-5xl" tabindex="-1">
                @if (status is null) { <span>Checking your network</span> }
                else if (protectedNow) { <span>Your network is <span class="text-ok">protected</span>.</span> }
                else { <span>Protection is <span class="text-danger">off</span>.</span> }
            </h1>
            <p class="mt-2 text-lg text-muted">
                @if (status is not null)
                {
                    <span>@(status.InternetReachable ? "The internet is reachable." : "The internet is not reachable right now.") </span>
                    <span>@(online == 0 ? "No devices are connected." : $"{Fmt.Plural(online, "device is", "devices are")} connected.")</span>
                }
            </p>
        </div>
    </div>
    @if (status is not null)
    {
        <p class="panel flex items-center gap-3 px-4 py-2">
            <Icon Name="@(status.InternetReachable ? "check" : "globe")" Class="@(status.InternetReachable ? "text-ok" : "text-warn")" />
            <span>
                <span class="block font-bold">@(status.InternetReachable ? "Online" : "No internet")</span>
                <span class="block text-sm text-muted">Running for @Fmt.Uptime(status.UptimeSeconds)</span>
            </span>
        </p>
    }
</div>

@* The wall itself: internet on one side, the home network on the other, and what is let through in between. *@
<section aria-label="How traffic passes the firewall" class="mt-8 grid gap-4 lg:grid-cols-3">
    <div class="card min-w-0">
        <h2 class="flex items-center gap-3 text-lg font-bold"><Icon Name="globe" Class="h-9 w-9 text-brand" />Internet side</h2>
        <p class="mt-3 text-3xl font-bold">@(State.Wan?.Addresses.FirstOrDefault()?.Split('/')[0] ?? "No address")</p>
        <p class="mt-1 flex items-center gap-2 @(wanUp ? "text-ok" : "text-warn")">
            @if (wanUp) { <Icon Name="check" /> }
            <span class="font-semibold">@(wanUp ? "Connected" : "No cable detected")</span>
            <span class="text-sm text-muted">Port @Config.WanInterface</span>
        </p>
        <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-4">
            <div class="flex items-center gap-2">
                <Icon Name="down" Class="text-down" />
                <div><dt class="text-sm text-muted">Coming in</dt><dd class="whitespace-nowrap text-lg font-bold">@Fmt.Rate(_downRate)</dd></div>
            </div>
            <div class="flex items-center gap-2">
                <Icon Name="up" Class="text-up" />
                <div><dt class="text-sm text-muted">Going out</dt><dd class="whitespace-nowrap text-lg font-bold">@Fmt.Rate(_upRate)</dd></div>
            </div>
        </dl>
    </div>

    <div class="card @(protectedNow ? "card-ok" : "") flex flex-col items-center justify-center text-center">
        <Icon Name="@(protectedNow ? "shield-check" : "shield")" Class="@($"h-16 w-16 {(protectedNow ? "text-ok" : "text-muted")}")" />
        <h2 class="mt-2 text-lg font-bold">Open ports</h2>
        <p><a class="text-5xl font-extrabold @(protectedNow ? "text-ok" : "") underline-offset-4 hover:underline" href="/ports" aria-label="@Fmt.Plural(openPorts, "open port", "open ports")">@openPorts</a></p>
        <p class="mt-1">
            <a class="font-bold underline underline-offset-4" href="/rules">@Fmt.Plural(rules, "rule", "rules")</a>
            <span class="block text-sm text-muted">Everything else from the internet is turned away.</span>
        </p>
    </div>

    <div class="card card-up min-w-0">
        <h2 class="flex items-center gap-3 text-lg font-bold"><Icon Name="ports" Class="h-9 w-9 text-up" />Your network</h2>
        <p class="mt-3 text-3xl font-bold">@Config.LanAddress</p>
        <p class="mt-1 flex items-center gap-2 @(lanUp ? "text-ok" : "text-warn")">
            @if (lanUp) { <Icon Name="check" /> }
            <span class="font-semibold">@(lanUp ? "Cable connected" : "No cable detected")</span>
            <span class="text-sm text-muted">Port @Config.LanInterface</span>
        </p>
        <div class="mt-4 space-y-2 border-t border-line pt-4">
            <p class="flex items-center gap-2"><Icon Name="devices" Class="text-muted" /><a class="font-bold underline underline-offset-4" href="/devices">@Fmt.Plural(online, "device", "devices") connected</a></p>
            @{ var offNow = AccessPlan.OffNow(Config.Access, DateTimeOffset.UtcNow, DateTime.Now).Count; }
            @if (offNow > 0)
            {
                <p class="flex items-center gap-2 text-sm text-muted"><Icon Name="clock" /><span><a class="font-bold text-ink underline underline-offset-4" href="/devices">@Fmt.Plural(offNow, "device has", "devices have")</a> the internet switched off right now.</span></p>
            }
            <p class="flex flex-wrap items-center gap-2 text-sm text-muted"><Icon Name="filter" />Content filter: <a class="tag bg-brand-soft text-ink underline-offset-4 hover:underline" href="/filter">@Fmt.FilterLevel(Config.Filter.Level)</a></p>
        </div>
    </div>
</section>

@if (State.Usage is { Periods.Count: > 0 } totals)
{
    <section aria-labelledby="totals-title" class="panel mt-4 p-5">
        <h2 id="totals-title" class="flex items-center gap-3 text-xl font-bold"><Icon Name="chart" Class="h-6 w-6 text-brand" />Total internet use</h2>
        <dl class="mt-3 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            @foreach (var period in totals.Periods)
            {
                var partial = DateTimeOffset.UtcNow - period.Since < TimeSpan.FromDays(period.Days) - TimeSpan.FromHours(1);
                <div>
                    <dt class="font-semibold text-muted">Last @period.Days days</dt>
                    <dd class="mt-1 flex flex-wrap items-baseline gap-x-6 gap-y-1">
                        <span class="flex items-center gap-2 whitespace-nowrap"><Icon Name="down" Class="text-down" /><span class="text-2xl font-bold">@Fmt.Bytes(period.DownBytes)</span><span class="text-sm text-muted">in</span></span>
                        <span class="flex items-center gap-2 whitespace-nowrap"><Icon Name="up" Class="text-up" /><span class="text-2xl font-bold">@Fmt.Bytes(period.UpBytes)</span><span class="text-sm text-muted">out</span></span>
                    </dd>
                    @if (partial)
                    {
                        <dd class="mt-1 text-sm text-muted">So far: counting began on @period.Since.ToLocalTime().ToString("d MMM 'at' HH:mm", CultureInfo.InvariantCulture).</dd>
                    }
                </div>
            }
        </dl>
    </section>
}

<div class="mt-4 grid gap-4 lg:grid-cols-[3fr_2fr]">
    <section aria-labelledby="traffic-title" class="panel min-w-0 p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 id="traffic-title" class="flex items-center gap-3 text-xl font-bold"><Icon Name="chart" Class="h-6 w-6 text-brand" />Internet traffic</h2>
            <p class="text-sm text-muted">The last two minutes</p>
        </div>
        @if (_samples.Count < 2)
        {
            <p class="mt-3 text-muted" role="status">Measuring. The chart appears after a few seconds.</p>
        }
        else
        {
            var max = Math.Max(1, _samples.Max(s => Math.Max(s.Down, s.Up)));
            <div class="mt-4 flex gap-3">
                <div aria-hidden="true" class="flex flex-col justify-between whitespace-nowrap text-right text-xs text-muted">
                    <span>@Fmt.Rate(max)</span><span>@Fmt.Rate(max / 2)</span><span>0</span>
                </div>
                <svg viewBox="0 0 600 140" class="h-40 min-w-0 flex-1" role="img" aria-label="@($"Traffic chart. Peak {Fmt.Rate(max)}.")" preserveAspectRatio="none">
                    @foreach (var y in new[] { 6, 71, 136 })
                    {
                        <line x1="0" y1="@y" x2="600" y2="@y" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />
                    }
                    <polygon fill="var(--down)" fill-opacity="0.18" points="@Area(s => s.Down, max)" />
                    <polygon fill="var(--up)" fill-opacity="0.18" points="@Area(s => s.Up, max)" />
                    <polyline fill="none" stroke="var(--down)" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="@Points(s => s.Down, max)" />
                    <polyline fill="none" stroke="var(--up)" stroke-width="2" stroke-dasharray="6 4" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="@Points(s => s.Up, max)" />
                </svg>
            </div>
            <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
                <span><span class="mr-2 inline-block h-0.5 w-5 bg-down align-middle"></span>Coming in <strong class="text-ink">@Fmt.Rate(_downRate)</strong></span>
                <span><span class="mr-2 inline-block w-5 border-t-2 border-dashed border-up align-middle"></span>Going out <strong class="text-ink">@Fmt.Rate(_upRate)</strong></span>
            </p>
        }
    </section>

    <section aria-labelledby="attention-title" class="panel min-w-0 p-5">
        <h2 id="attention-title" class="flex items-center gap-3 text-xl font-bold"><Icon Name="bell" Class="@($"h-6 w-6 {(attention.Count == 0 ? "text-muted" : "text-warn")}")" />Needs your attention</h2>
        @if (attention.Count == 0)
        {
            <p class="mt-4 flex items-start gap-3"><Icon Name="check" Class="mt-0.5 text-ok" /><span><strong class="block">Nothing right now.</strong><span class="text-muted">Palisade will list problems here when it finds them.</span></span></p>
        }
        else
        {
            <ul class="mt-4 space-y-3">
                @foreach (var (text, href, link) in attention)
                {
                    <li class="rounded-lg border border-warn bg-warn-soft p-3">
                        @text <a class="font-bold underline underline-offset-4" href="@href">@link</a>
                    </li>
                }
            </ul>
        }
        @if (status is not null)
        {
            <p class="mt-6 flex items-center gap-2 border-t border-line pt-4 text-sm text-muted"><Icon Name="clock" />@status.Hostname has been running for @Fmt.Uptime(status.UptimeSeconds).</p>
        }
    </section>
</div>

@{
    var usage = Ranked();
    var top = usage.Take(8).ToList();
    var scale = Math.Max(1, top.Select(u => Math.Max(Measure(u, down: true), Measure(u, down: false))).DefaultIfEmpty(1).Max());
}
<section aria-labelledby="usage-title" class="panel mt-4 p-5">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div class="flex items-center gap-3">
            <Icon Name="people" Class="h-9 w-9 text-brand" />
            <div>
                <h2 id="usage-title" class="text-xl font-bold">Who is using the internet</h2>
                <p class="text-sm text-muted">@(_byRate ? "Ordered by speed over the last few seconds." : $"Ordered by total use {SinceText()}.")</p>
            </div>
        </div>
        <div role="group" aria-label="Order the list by" class="flex gap-1">
            <button type="button" class="btn @(_byRate ? "" : "btn-primary")" aria-pressed="@(_byRate ? "false" : "true")" @onclick="() => _byRate = false">Total</button>
            <button type="button" class="btn @(_byRate ? "btn-primary" : "")" aria-pressed="@(_byRate ? "true" : "false")" @onclick="() => _byRate = true">Right now</button>
        </div>
    </div>

    @if (State.Usage is null)
    {
        <p class="mt-4 text-muted" role="status">Measuring.</p>
    }
    else if (top.Count == 0)
    {
        <p class="mt-4 text-muted">@(_byRate ? "No device is using the internet at this moment." : $"No device has used the internet {SinceText()}.")</p>
    }
    else
    {
        <ol class="mt-3 divide-y divide-line">
            @foreach (var u in top)
            {
                var device = devices.FirstOrDefault(d => d.Address == u.Address);
                var down = Measure(u, down: true);
                var up = Measure(u, down: false);
                <li class="grid items-center gap-x-5 gap-y-2 py-3 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_auto_auto]">
                    <div class="flex min-w-0 items-center gap-3">
                        <Icon Name="@((device?.Type ?? DeviceType.Unknown).ToString().ToLowerInvariant())" Class="h-7 w-7 text-brand" />
                        <div class="min-w-0">
                            <p class="truncate font-bold">@(device?.Name ?? "Unknown device")</p>
                            <p class="text-sm text-muted">@u.Address</p>
                        </div>
                    </div>
                    <div aria-hidden="true" class="space-y-1.5">
                        <div class="h-2 rounded-full bg-down" style="width: @Width(down, scale)"></div>
                        <div class="h-2 rounded-full bg-up" style="width: @Width(up, scale)"></div>
                    </div>
                    <p class="whitespace-nowrap text-sm sm:text-right">
                        <span class="block"><span class="font-bold">@Show(down)</span> <span class="mx-1 inline-block h-2 w-2 rounded-full bg-down" aria-hidden="true"></span><span class="text-muted">coming in</span></span>
                        <span class="block"><span class="font-bold">@Show(up)</span> <span class="mx-1 inline-block h-2 w-2 rounded-full bg-up" aria-hidden="true"></span><span class="text-muted">going out</span></span>
                    </p>
                    <button type="button" class="btn" aria-label="@($"See where {device?.Name ?? u.Address} connects to")" @onclick="() => StartWatchAsync(u.Address, device?.Name ?? u.Address)">Where to?</button>
                </li>
            }
        </ol>
        @if (usage.Count > top.Count)
        {
            <p class="mt-2 text-sm text-muted">And @Fmt.Plural(usage.Count - top.Count, "more device", "more devices") using less than these.</p>
        }
    }
    <p class="mt-3 text-sm text-muted">Counts traffic between your devices and the internet. Totals start again from zero if the firewall restarts.</p>
</section>

<Modal Open="_watchFor is not null" Title="@($"Where {_watchName} connects to")" OnClose="CloseWatch">
    @if (_watching)
    {
        <p role="status">Counting what this device sends and receives for @WatchPlan.DefaultSeconds seconds. Keep this open.</p>
        <p class="field-hint">Only addresses, ports and sizes are counted. Nothing the device says is read or kept.</p>
    }
    else if (_watch is { Problem.Length: > 0 })
    {
        <p role="alert" class="rounded-lg border border-warn bg-warn-soft p-3">@_watch.Problem</p>
    }
    else if (_watch is not null)
    {
        @if (_watch.Flows.Count == 0)
        {
            <p>This device sent and received nothing through the firewall in those @_watch.Seconds seconds.</p>
        }
        else
        {
            <p class="text-muted">In @_watch.Seconds seconds, biggest first.</p>
            <ul class="mt-3 divide-y divide-line">
                @foreach (var flow in _watch.Flows.Take(15))
                {
                    <li class="py-3">
                        <p class="break-all font-bold">@(flow.Name.Length > 0 ? flow.Name : flow.Address)</p>
                        <p class="text-sm text-muted">@(flow.Name.Length > 0 ? $"{flow.Address} · " : "")@WatchPlan.PortName(flow.Protocol, flow.Port)</p>
                        <p class="mt-1 text-sm">
                            <span class="mr-4 whitespace-nowrap"><span class="mr-1 inline-block h-2 w-2 rounded-full bg-up" aria-hidden="true"></span><strong>@Fmt.Bytes(flow.UpBytes)</strong> sent to it</span>
                            <span class="whitespace-nowrap"><span class="mr-1 inline-block h-2 w-2 rounded-full bg-down" aria-hidden="true"></span><strong>@Fmt.Bytes(flow.DownBytes)</strong> received from it</span>
                        </p>
                    </li>
                }
            </ul>
            @if (_watch.Flows.Count > 15)
            {
                <p class="mt-2 text-sm text-muted">And @Fmt.Plural(_watch.Flows.Count - 15, "smaller connection", "smaller connections").</p>
            }
        }
        <button type="button" class="btn mt-4" @onclick="() => StartWatchAsync(_watchFor!, _watchName)">Count again</button>
    }
</Modal>

@code {
    [Inject] private ITrafficWatch Watcher { get; set; } = default!;

    private string? _watchFor;
    private string _watchName = "";
    private bool _watching;
    private WatchReport? _watch;

    private async Task StartWatchAsync(string address, string name)
    {
        if (_watching) return;
        (_watchFor, _watchName, _watching, _watch) = (address, name, true, null);
        try { _watch = await Watcher.WatchAsync(new WatchRequest { Address = address }); }
        catch (Exception ex) { _watch = new WatchReport { Problem = $"The firewall did not answer. ({ex.Message})" }; }
        _watching = false;
    }

    private void CloseWatch() => _watchFor = null;

    private bool _byRate;

    private double Measure(DeviceUsage u, bool down) => _byRate ? (down ? u.DownRate : u.UpRate) : (down ? u.DownBytes : u.UpBytes);

    private List<DeviceUsage> Ranked() => (State.Usage?.Devices ?? [])
        .Where(u => Measure(u, true) + Measure(u, false) > 0)
        .OrderByDescending(u => Measure(u, true) + Measure(u, false))
        .ToList();

    private string Show(double value) => _byRate ? Fmt.Rate(value) : Fmt.Bytes((long)value);

    // A sliver stays visible for anything above zero, so a quiet device is not mistaken for a silent one.
    private static string Width(double value, double scale) =>
        value <= 0 ? "0" : string.Create(CultureInfo.InvariantCulture, $"{Math.Max(1.5, value / scale * 100):0.#}%");

    private string SinceText()
    {
        if (State.Usage is not { } report) return "";
        if (DateTimeOffset.UtcNow - report.Since > TimeSpan.FromHours(23.9)) return "over the last 24 hours";
        var since = report.Since.ToLocalTime();
        return $"since {since.ToString("HH:mm", CultureInfo.InvariantCulture)}{(since.Date == DateTimeOffset.Now.Date ? "" : " yesterday")}";
    }

    private readonly List<(double Down, double Up)> _samples = [];
    private (long Rx, long Tx, DateTimeOffset At)? _last;
    private double _downRate, _upRate;
    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            do
            {
                await State.RefreshStatusAsync();
                if (State.Wan is { } wan)
                {
                    var now = DateTimeOffset.UtcNow;
                    if (_last is { } last && (now - last.At).TotalSeconds > 0.2)
                    {
                        var seconds = (now - last.At).TotalSeconds;
                        _downRate = Math.Max(0, (wan.RxBytes - last.Rx) / seconds);
                        _upRate = Math.Max(0, (wan.TxBytes - last.Tx) / seconds);
                        _samples.Add((_downRate, _upRate));
                        if (_samples.Count > 60) _samples.RemoveAt(0);
                    }
                    _last = (wan.RxBytes, wan.TxBytes, now);
                }
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) { }
    }

    private string Points(Func<(double Down, double Up), double> pick, double max) =>
        string.Join(' ', _samples.Select((s, i) => string.Create(CultureInfo.InvariantCulture,
            $"{i * 600.0 / 59:0.#},{136 - pick(s) / max * 130:0.#}")));

    // The same line, closed along the bottom edge so it can be filled.
    private string Area(Func<(double Down, double Up), double> pick, double max) =>
        string.Create(CultureInfo.InvariantCulture, $"0,136 {Points(pick, max)} {(_samples.Count - 1) * 600.0 / 59:0.#},136");

    private IEnumerable<(string Text, string Href, string Link)> Attention()
    {
        if (State.Status is not { } s) yield break;
        // A box that carries relay software keeps trying. One that stopped a day ago, or is already paused, needs no nagging.
        foreach (var device in State.Devices().Where(d => d.Relay is { } r && DateTimeOffset.UtcNow - r.LastSeen < TimeSpan.FromDays(1)))
        {
            if (device.Access is { } access && AccessPlan.IsPausedByHand(access, DateTimeOffset.UtcNow)) continue;
            yield return ($"{device.Name} keeps trying to reach a service that rents your internet connection out to strangers. Palisade refused it {Fmt.Plural((int)Math.Min(device.Relay!.Attempts, int.MaxValue), "time", "times")}, but a device like this often has other ways out.", "/devices", "Pause its internet on the Devices page");
        }
        if (!s.FirewallActive) yield return ("The firewall rules are not loaded, so nothing is being filtered.", "/network", "Save your network settings again to reload them");
        if (!s.InternetReachable) yield return ("The firewall can't reach the internet. Check the cable on the internet port.", "/network", "See network settings");
        if (State.Wan is { IsUp: false }) yield return ($"No cable is detected on the internet port ({Config.WanInterface}).", "/network", "See network settings");
        if (Config.Dhcp.Enabled && !s.DhcpRunning) yield return ("Automatic addresses are switched on, but the service that hands them out has stopped.", "/network", "See network settings");
        if (!Config.Dhcp.Enabled) yield return ("Automatic addresses are off, so new devices must be set up by hand.", "/network", "Turn them on");
        if (Config.AllowManagementFromWan) yield return ("This firewall can be managed from the internet side. That is fine in a test lab and risky anywhere else.", "/network", "Review this setting");
    }

    public override void Dispose()
    {
        _cts.Cancel();
        base.Dispose();
    }
}
