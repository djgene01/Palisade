<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Palisade.Core\Palisade.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;data\**" />
    <None Include="package.json;package-lock.json" />
    <TailwindInput Include="Styles\app.css;Components\**\*.razor" />
  </ItemGroup>

  <!-- Compiles Tailwind into wwwroot/app.css as part of every build and publish, so the Debian box never needs Node. -->
  <Target Name="TailwindBuild" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(TailwindInput)" Outputs="wwwroot\app.css">
    <Exec Command="npm install" Condition="!Exists('node_modules')" />
    <Exec Command="npx @tailwindcss/cli -i Styles/app.css -o wwwroot/app.css --minify" />
  </Target>

</Project>
