@* The palisade: a row of pointed timber stakes. It is the product's one recurring motif. *@
<svg class="@Class" viewBox="0 0 @(Count * 14 - 2) 44" fill="currentColor" aria-hidden="true">
    @for (var i = 0; i < Count; i++)
    {
        var x = i * 14;
        <path d="M@(x) 9 L@(x + 6) 0 L@(x + 12) 9 V44 H@(x) Z" />
    }
</svg>

@code {
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public string Class { get; set; } = "h-6";
}
