@using System.Globalization
@* One reading on the System page: a big percentage, a bar, and what it is out of. *@
<div class="panel min-w-0 p-5">
    <h2 class="flex items-center gap-2 font-bold"><Icon Name="@Icon" Class="h-5 w-5 text-brand" />@Title</h2>
    @if (Percent is { } value)
    {
        var bar = Danger > 0 && value >= Danger ? "bg-danger" : Warn > 0 && value >= Warn ? "bg-warn" : "bg-brand";
        <p class="mt-2 text-4xl font-extrabold tabular-nums">@value.ToString("0", CultureInfo.InvariantCulture)<span class="text-2xl">%</span></p>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-sunk" role="meter" aria-label="@Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(value)">
            <div class="@($"h-full rounded-full {bar}")" style="@($"width:{Math.Clamp(value, 0, 100).ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
        </div>
        <p class="mt-2 text-sm text-muted">@Detail</p>
    }
    else
    {
        <p class="mt-2 text-muted" role="status">@Waiting</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public double? Percent { get; set; }
    [Parameter] public string Detail { get; set; } = "";
    [Parameter] public string Waiting { get; set; } = "Not read yet.";
    /// <summary>From this share the bar turns amber, and red from <see cref="Danger"/>. Zero leaves it plain.</summary>
    [Parameter] public double Warn { get; set; }
    [Parameter] public double Danger { get; set; }
}
