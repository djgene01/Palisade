@using System.Globalization
@using System.Text
@* One history line on the System page, from 0 to 100%, with points placed by their time so that
   hours when the firewall was off show as a break rather than being squeezed out. *@
@{
    var values = Report.Points.Select(Value).OfType<double>().ToList();
    var peaks = Peak is null ? [] : Report.Points.Select(Peak).OfType<double>().ToList();
    var summary = values.Count == 0 ? "No readings." : $"Average {values.Average():0}%, highest {(peaks.Count > 0 ? peaks.Max() : values.Max()):0}%.";
}
<section class="panel min-w-0 p-5" aria-label="@($"{Title} history")">
    <h3 class="font-bold">@Title</h3>
    <p class="text-sm text-muted">@summary</p>
    <div class="mt-3 flex gap-2">
        <div aria-hidden="true" class="flex flex-col justify-between text-right text-xs text-muted"><span>100%</span><span>50%</span><span>0%</span></div>
        <svg viewBox="0 0 @Width @Height" class="h-36 min-w-0 flex-1" role="img" aria-label="@($"{Title} over the last {RangeWords(Report.Range)}. {summary}")" preserveAspectRatio="none">
            @foreach (var y in new[] { 1.0, Height / 2.0, Height - 1.0 })
            {
                <line x1="0" y1="@F(y)" x2="@Width" y2="@F(y)" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />
            }
            @if (Peak is not null)
            {
                @foreach (var line in Lines(Peak))
                {
                    <polyline fill="none" stroke="@Color" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="3 3" stroke-linejoin="round" vector-effect="non-scaling-stroke" points="@line" />
                }
            }
            @foreach (var line in Lines(Value))
            {
                <polyline fill="none" stroke="@Color" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" points="@line" />
            }
        </svg>
    </div>
    <div aria-hidden="true" class="mt-1 flex justify-between pl-9 text-xs text-muted">
        <span>@Label(Report.From, Report.Range)</span><span>@Label(Report.From + (Report.To - Report.From) / 2, Report.Range)</span><span>Now</span>
    </div>
    @if (Peak is not null)
    {
        <p class="mt-2 flex flex-wrap gap-x-5 text-xs text-muted">
            <span><span class="mr-1.5 inline-block h-0.5 w-4 align-middle" style="background:@Color"></span>Average</span>
            <span><span class="mr-1.5 inline-block w-4 border-t-2 border-dashed align-middle" style="border-color:@Color"></span>Busiest moment</span>
        </p>
    }
</section>

@code {
    private const int Width = 600, Height = 140;

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public HealthReport Report { get; set; } = default!;
    [Parameter, EditorRequired] public Func<HealthPoint, double?> Value { get; set; } = default!;
    /// <summary>A second, dashed line, such as the busiest reading in each stretch.</summary>
    [Parameter] public Func<HealthPoint, double?>? Peak { get; set; }
    [Parameter] public string Color { get; set; } = "var(--brand)";

    /// <summary>The line in pieces: a new piece starts wherever readings are missing.</summary>
    private IEnumerable<string> Lines(Func<HealthPoint, double?> pick)
    {
        var from = Report.From.ToUnixTimeSeconds();
        var span = Math.Max(1, Report.To.ToUnixTimeSeconds() - from);
        var line = new StringBuilder();
        long? last = null;
        foreach (var point in Report.Points)
        {
            if (pick(point) is not { } value) { last = null; continue; }
            if (last is { } previous && point.At - previous > Report.Step * 1.5 && line.Length > 0)
            {
                yield return Finish(line);
                line.Clear();
            }
            // A point stands for its whole stretch, so it is drawn at the stretch's middle.
            var x = Math.Clamp((point.At + Report.Step / 2.0 - from) / span * Width, 0, Width);
            var y = Height - 1 - Math.Clamp(value, 0, 100) / 100 * (Height - 2);
            line.Append(F(x)).Append(',').Append(F(y)).Append(' ');
            last = point.At;
        }
        if (line.Length > 0) yield return Finish(line);
    }

    // A lone reading between two gaps would be invisible as a line of one point, so it gets a short flat stroke.
    private static string Finish(StringBuilder line)
    {
        var text = line.ToString().Trim();
        if (text.Contains(' ')) return text;
        var parts = text.Split(',');
        var x = double.Parse(parts[0], CultureInfo.InvariantCulture);
        return $"{F(Math.Max(0, x - 1.5))},{parts[1]} {F(Math.Min(Width, x + 1.5))},{parts[1]}";
    }

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    private static string RangeWords(HealthRange range) => range switch
    {
        HealthRange.Hour => "hour", HealthRange.Day => "day", HealthRange.Week => "week", _ => "month",
    };

    /// <summary>A time on the axis: the clock for an hour or a day, the date for longer.</summary>
    public static string Label(DateTimeOffset time, HealthRange range)
    {
        var local = time.ToLocalTime();
        return range is HealthRange.Hour or HealthRange.Day
            ? local.ToString("HH:mm", CultureInfo.InvariantCulture)
            : local.ToString("d MMM", CultureInfo.InvariantCulture);
    }
}
