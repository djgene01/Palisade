<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The screens of Palisade, shared by the firewall's own web interface and the companion app.
       Nothing in here touches the system or the network directly: every action goes through the
       interfaces in Palisade.Core and the few in Services/Host.cs, which each host provides. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Palisade.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Palisade.Core\Palisade.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;package-lock.json" />
    <!-- The stylesheet also covers the hosts' own screens (web sign-in and setup, the app's linking), so their markup counts as input too. -->
    <TailwindInput Include="Styles\app.css;**\*.razor;..\Palisade.Web\Components\**\*.razor;..\Palisade.App\Components\**\*.razor" Exclude="node_modules\**;bin\**;obj\**" />
  </ItemGroup>

  <!-- Compiles Tailwind into wwwroot/app.css as part of every build and publish, so the firewall never needs Node. -->
  <Target Name="TailwindBuild" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(TailwindInput)" Outputs="wwwroot\app.css">
    <Exec Command="npm install" Condition="!Exists('node_modules')" />
    <Exec Command="npx @tailwindcss/cli -i Styles/app.css -o wwwroot/app.css --minify" />
  </Target>

</Project>
