@page "/network"
@inherits StatePage

<PageTitle>Network · Palisade</PageTitle>

<h1 class="text-3xl font-extrabold md:text-4xl" tabindex="-1">Network</h1>
<p class="mt-2 max-w-2xl text-lg text-muted">How the firewall connects to the internet and to your devices. Changes here are tested before they are kept, and undone by themselves if they cut you off.</p>

<form class="mt-8 max-w-2xl space-y-10" @onsubmit="SaveAllAsync">
    <section aria-labelledby="lan-title">
        <h2 id="lan-title" class="text-xl font-bold">Your network</h2>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div>
                <label for="lan-address" class="field-label">Firewall address</label>
                <input id="lan-address" class="input" inputmode="decimal" value="@_draft.LanAddress" @onchange="OnLanAddressChanged" />
                <p class="field-hint">Devices use this address to reach the internet and this page.</p>
            </div>
            <div>
                <label for="lan-size" class="field-label">Network size</label>
                <select id="lan-size" class="input" @bind="_draft.LanPrefix">
                    <option value="24">Up to 253 devices (/24)</option>
                    <option value="23">Up to 509 devices (/23)</option>
                    <option value="22">Up to 1021 devices (/22)</option>
                    <option value="16">Up to 65,533 devices (/16)</option>
                    @if (_draft.LanPrefix is not (24 or 23 or 22 or 16))
                    {
                        <option value="@_draft.LanPrefix">/@_draft.LanPrefix</option>
                    }
                </select>
            </div>
        </div>
        @if (_draft.LanAddress != Config.LanAddress)
        {
            <p class="mt-3 rounded-md border border-warn bg-warn-soft p-3">
                After saving, this page moves to <strong>http://@_draft.LanAddress:@PalisadeDefaults.WebPort</strong>. Reconnect your device, open that address and sign in within @PalisadeDefaults.ConfirmSeconds seconds, or the old address comes back.
            </p>
        }
    </section>

    <section aria-labelledby="dhcp-title">
        <div class="flex items-center justify-between gap-4">
            <div>
                <h2 id="dhcp-title" class="text-xl font-bold">Automatic addresses</h2>
                <p class="field-hint">Gives each device that joins an address, so nobody has to set one up by hand. Also called DHCP.</p>
            </div>
            <Toggle @bind-Value="_draft.Dhcp.Enabled" Label="Hand out addresses automatically" />
        </div>
        @if (_draft.Dhcp.Enabled)
        {
            <div class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <label for="dhcp-start" class="field-label">First address</label>
                    <input id="dhcp-start" class="input" inputmode="decimal" @bind="_draft.Dhcp.RangeStart" />
                </div>
                <div>
                    <label for="dhcp-end" class="field-label">Last address</label>
                    <input id="dhcp-end" class="input" inputmode="decimal" @bind="_draft.Dhcp.RangeEnd" />
                </div>
                <div>
                    <label for="dhcp-hours" class="field-label">Lend for (hours)</label>
                    <input id="dhcp-hours" class="input" type="number" min="1" max="720" @bind="_draft.Dhcp.LeaseHours" />
                </div>
            </div>
        }
        <div class="mt-4">
            <label for="dns" class="field-label">Name servers (DNS)</label>
            <input id="dns" class="input" @bind="_dns" />
            <p class="field-hint">Where the firewall looks up website names for your devices. Separate addresses with commas. Leave empty to use whatever the internet side provides.</p>
            @if (Config.Filter.Level != FilterLevel.Off)
            {
                <p class="field-hint">The <a class="font-bold text-brand underline underline-offset-4" href="/filter">content filter</a> is on, so lookups go to its filtering service instead. These servers are still used for devices set to "No filtering" and for sites you always allow.</p>
            }
        </div>
    </section>

    <section aria-labelledby="flush-title">
        <h2 id="flush-title" class="text-xl font-bold">Clear remembered lookups</h2>
        <p class="mt-1 text-muted">The firewall remembers where sites are for a while, so pages open faster. Clear that memory when a site has moved, or a change to the content filter doesn't seem to take. Also called flushing the DNS cache.</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
            <button type="button" class="btn" disabled="@_flushing" @onclick="FlushDnsAsync"><Icon Name="refresh" />@(_flushing ? "Clearing" : "Flush DNS")</button>
            @if (_flushed is not null)
            {
                <p role="status" class="@(_flushOk ? "text-ok" : "text-warn") font-semibold">@_flushed</p>
            }
        </div>
        <p class="field-hint">Nothing is disconnected. Your devices keep their own memory too: if one still shows the old site, restart its browser or switch its Wi-Fi off and on.</p>
    </section>

    <section aria-labelledby="extra-title">
        <h2 id="extra-title" class="text-xl font-bold">Extra networks</h2>
        <p class="mt-1 text-muted">For devices on the same cables as your network whose addresses were set by hand in another range, such as cameras on 192.168.10.x. The firewall takes one free address in that range, and your devices can then reach everything in it. Devices there cannot start a connection to yours.</p>
        @foreach (var net in _draft.ExtraNetworks)
        {
            <fieldset class="mt-4 rounded-md border border-line p-4">
                <legend class="px-1 font-bold">@(net.Name.Length > 0 ? net.Name : "New network")</legend>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label for="extra-name-@net.Id" class="field-label">Name</label>
                        <input id="extra-name-@net.Id" class="input" maxlength="40" @bind="net.Name" />
                    </div>
                    <div>
                        <label for="extra-address-@net.Id" class="field-label">Firewall address there</label>
                        <input id="extra-address-@net.Id" class="input" inputmode="decimal" placeholder="192.168.10.254" @bind="net.Address" />
                    </div>
                    <div>
                        <label for="extra-size-@net.Id" class="field-label">Network size</label>
                        <select id="extra-size-@net.Id" class="input" @bind="net.Prefix">
                            <option value="24">Up to 253 devices (/24)</option>
                            <option value="23">Up to 509 devices (/23)</option>
                            <option value="22">Up to 1021 devices (/22)</option>
                            <option value="16">Up to 65,533 devices (/16)</option>
                            @if (net.Prefix is not (24 or 23 or 22 or 16))
                            {
                                <option value="@net.Prefix">/@net.Prefix</option>
                            }
                        </select>
                    </div>
                </div>
                <p class="field-hint">Pick an address no device there uses. With 192.168.10.254 and the size /24, the range is 192.168.10.1 to 192.168.10.254.</p>
                <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <Toggle @bind-Value="net.InternetAccess" Label="@($"Let devices in {(net.Name.Length > 0 ? net.Name : "this network")} use the internet")" />
                        <span>Let these devices use the internet</span>
                    </div>
                    <button type="button" class="btn" @onclick="() => _draft.ExtraNetworks.Remove(net)">Remove</button>
                </div>
            </fieldset>
        }
        @if (_draft.ExtraNetworks.Count < ExtraNetwork.Max)
        {
            <button type="button" class="btn mt-4" @onclick="() => _draft.ExtraNetworks.Add(new())">Add a network</button>
        }
    </section>

    <section aria-labelledby="wan-title">
        <h2 id="wan-title" class="text-xl font-bold">Internet side</h2>
        <p class="mt-1 text-muted">
            Port @Config.WanInterface, address @(State.Wan?.Addresses.FirstOrDefault() ?? "none yet"). It gets that address from the equipment it is connected to.
        </p>

        <div class="mt-4 flex items-start gap-4">
            <Toggle @bind-Value="_draft.NatEnabled" Label="Share one internet address between all devices" />
            <div>
                <p class="font-bold">Share one internet address between all devices</p>
                <p class="text-muted">Also called NAT. Leave this on unless the router upstream has been told a route to your network.</p>
            </div>
        </div>

        <div class="mt-4 flex items-start gap-4">
            <Toggle @bind-Value="_draft.AllowManagementFromWan" Label="Allow managing the firewall from the internet side" />
            <div>
                <p class="font-bold">Allow managing the firewall from the internet side</p>
                <p class="text-muted">Opens this page and remote login (SSH) to the internet side. Useful in a test lab, risky on a real internet connection.</p>
            </div>
        </div>
    </section>

    <section aria-labelledby="ports-title">
        <h2 id="ports-title" class="text-xl font-bold">Which port is which</h2>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div>
                <label for="wan-port" class="field-label">Internet port</label>
                <select id="wan-port" class="input" @bind="_draft.WanInterface">
                    @foreach (var name in PortNames) { <option value="@name">@PortLabel(name)</option> }
                </select>
                <p class="field-hint">A cabled internet port asks your provider's equipment for an address by itself.</p>
            </div>
            <div>
                <label for="lan-port" class="field-label">Home network port</label>
                <select id="lan-port" class="input" @bind="_draft.LanInterface">
                    @foreach (var name in PortNames) { <option value="@name">@PortLabel(name)</option> }
                </select>
            </div>
            <div class="sm:col-span-2">
                <label for="maint-port" class="field-label">Maintenance port</label>
                <select id="maint-port" class="input sm:max-w-xs" @bind="_draft.MaintenanceInterface">
                    <option value="">None</option>
                    @foreach (var name in PortNames.Append(Config.MaintenanceInterface).Where(n => n.Length > 0).Distinct()) { <option value="@name">@PortLabel(name)</option> }
                </select>
                <p class="field-hint">A spare port, usually the Wi-Fi, that can open this page and remote login (SSH) and nothing else. Nothing is passed between it and your network or the internet. Handy as a way in when the other ports are busy or misbehaving.</p>
            </div>
        </div>
    </section>

    <div class="space-y-4">
        <Problems Issues="Issues" />
        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" disabled="@_busy">Save network settings</button>
            <button type="button" class="btn" @onclick="Reset">Discard changes</button>
        </div>
    </div>
</form>

@if (State.Wifi is { Interface.Length: > 0 } wifi)
{
    <section aria-labelledby="wifi-title" class="mt-12 max-w-2xl border-t border-line pt-8">
        <h2 id="wifi-title" class="text-xl font-bold">The firewall's own Wi-Fi</h2>
        <p class="mt-1 text-muted">
            @if (wifi.Connected)
            {
                <span>Joined to <strong class="text-ink">@wifi.Ssid</strong>@(wifi.Address.Length > 0 ? $", with the address {wifi.Address}" : ", waiting for an address"). </span>
            }
            else
            {
                <span>Not joined to any Wi-Fi network right now. </span>
            }
            <span>Its role is @WifiRole(wifi.Interface).</span>
        </p>

        <form class="mt-4 space-y-4" @onsubmit="JoinWifiAsync">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="wifi-name" class="field-label">Wi-Fi name</label>
                    <input id="wifi-name" class="input" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="32" @bind="_wifiName" />
                </div>
                <div>
                    <label for="wifi-pass" class="field-label">Wi-Fi password</label>
                    <input id="wifi-pass" class="input" type="password" autocomplete="new-password" maxlength="63" @bind="_wifiPass" />
                </div>
            </div>
            <p class="field-hint">Joining takes up to half a minute. If the firewall can't get on, it goes back to the Wi-Fi it uses now. If you are reading this page through that Wi-Fi, you will be disconnected: join the new Wi-Fi yourself and open the firewall's page again.</p>
            <Problems Issues="_wifiIssues" />
            @if (_wifiDone)
            {
                <p role="status" class="rounded-md border border-brand bg-brand-soft p-3 font-semibold">The firewall has joined @State.Wifi?.Ssid.</p>
            }
            <button type="submit" class="btn" disabled="@_wifiBusy">@(_wifiBusy ? "Joining, this takes a moment" : "Join this Wi-Fi")</button>
        </form>
    </section>
}

@code {
    [Inject] private IDnsControl Dns { get; set; } = default!;

    private bool _flushing, _flushOk;
    private string? _flushed;

    private async Task FlushDnsAsync()
    {
        (_flushing, _flushed) = (true, null);
        try
        {
            var result = await Dns.FlushDnsAsync();
            _flushOk = result.Ok;
            _flushed = result.Ok
                ? $"Cleared at {DateTime.Now:HH:mm:ss}. The next lookup of every site is asked afresh."
                : result.Issues.FirstOrDefault()?.Message ?? "The lookups could not be cleared.";
        }
        catch (Exception ex)
        {
            (_flushOk, _flushed) = (false, Problem.Explain(ex, "The firewall service did not answer."));
        }
        _flushing = false;
    }

    private string _wifiName = "", _wifiPass = "";
    private bool _wifiBusy, _wifiDone;
    private IReadOnlyList<ValidationIssue> _wifiIssues = [];

    protected override async Task OnInitializedAsync() => await State.RefreshWifiAsync();

    private string PortLabel(string name) =>
        State.Status?.Interfaces.FirstOrDefault(i => i.Name == name) is { IsWireless: true } ? $"{name} (Wi-Fi)" : name;

    private string WifiRole(string name) =>
        name == Config.WanInterface ? "the internet port"
        : name == Config.LanInterface ? "the home network port"
        : name == Config.MaintenanceInterface ? "the maintenance port"
        : "none yet: choose it as the maintenance port above to be able to open this page through it";

    private async Task JoinWifiAsync()
    {
        _wifiDone = false;
        if (_wifiName.Trim().Length == 0)
        {
            _wifiIssues = [new("", "Type the name of the Wi-Fi network.")];
            return;
        }
        _wifiBusy = true;
        _wifiIssues = await State.JoinWifiAsync(_wifiName.Trim(), _wifiPass);
        _wifiBusy = false;
        _wifiDone = _wifiIssues.Count == 0;
        if (_wifiDone) (_wifiName, _wifiPass) = ("", "");
    }

    private FirewallConfig _draft = new();
    private string _dns = "";
    private bool _busy;

    private IEnumerable<string> PortNames =>
        (State.Status?.Interfaces.Select(i => i.Name) ?? []).Append(Config.WanInterface).Append(Config.LanInterface).Distinct();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Reset();
    }

    private void Reset()
    {
        _draft = Config.Clone();
        _dns = string.Join(", ", _draft.Dhcp.UpstreamDns);
        Issues = [];
    }

    private void OnLanAddressChanged(ChangeEventArgs e)
    {
        _draft.LanAddress = ((string?)e.Value ?? "").Trim();
        // Moving to a different range would strand the old automatic addresses, so move them along.
        if (Ip4.TryParse(_draft.LanAddress, out var lan)
            && !(Ip4.TryParse(_draft.Dhcp.RangeStart, out var start) && start.IsIn(lan, _draft.LanPrefix) && start.Value > lan.Value))
            (_draft.Dhcp.RangeStart, _draft.Dhcp.RangeEnd) = Fmt.SuggestRange(lan, _draft.LanPrefix);
    }

    private async Task SaveAllAsync()
    {
        _busy = true;
        var dns = _dns.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        var saved = await SaveAsync(c =>
        {
            c.WanInterface = _draft.WanInterface;
            c.LanInterface = _draft.LanInterface;
            c.LanAddress = _draft.LanAddress;
            c.LanPrefix = _draft.LanPrefix;
            c.NatEnabled = _draft.NatEnabled;
            c.AllowManagementFromWan = _draft.AllowManagementFromWan;
            c.MaintenanceInterface = _draft.MaintenanceInterface;
            c.ExtraNetworks = [.. _draft.ExtraNetworks.Select(n => new ExtraNetwork
                { Id = n.Id, Name = n.Name.Trim(), Address = n.Address.Trim(), Prefix = n.Prefix, InternetAccess = n.InternetAccess })];
            c.Dhcp.Enabled = _draft.Dhcp.Enabled;
            c.Dhcp.RangeStart = _draft.Dhcp.RangeStart.Trim();
            c.Dhcp.RangeEnd = _draft.Dhcp.RangeEnd.Trim();
            c.Dhcp.LeaseHours = _draft.Dhcp.LeaseHours;
            c.Dhcp.UpstreamDns = dns;
        });
        _busy = false;
        if (saved) Reset();
    }
}
