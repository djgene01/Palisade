@page "/devices"
@inherits StatePage
@using System.Globalization

<PageTitle>Devices · Palisade</PageTitle>

<h1 class="text-3xl font-extrabold md:text-4xl" tabindex="-1">Devices</h1>
<p class="mt-2 max-w-2xl text-lg text-muted">Everything that has joined your network. Choose a device, then use the buttons to pause it, limit it or fix its address.</p>

<WaitingDevices />

@{
    var devices = State.Devices();
    var now = DateTimeOffset.Now;
    var shown = devices.Where(Matches).ToList();
    var chosen = devices.FirstOrDefault(d => d.Mac == _selected);
    var chosenPaused = chosen?.Access is { } chosenAccess && AccessPlan.IsPausedByHand(chosenAccess, now);
    var none = chosen is null || _busy;
}

<div class="mt-6 max-w-4xl">
    @if (_pauseFor is null && _scheduleFor is null && _renameFor is null && _limitFor is null) { <div class="mb-4"><Problems Issues="Issues" /></div> }

    @if (devices.Count == 0)
    {
        <div class="panel p-6">
            <p class="font-bold">No devices have joined yet.</p>
            @if (Config.Dhcp.Enabled)
            {
                <p class="mt-1 text-muted">Plug a device into the home network port (@Config.LanInterface), or into a switch or Wi-Fi access point connected to it. It shows up here within a few seconds.</p>
            }
            else
            {
                <p class="mt-1 text-muted">Automatic addresses are off, so Palisade can't see devices join. <a class="font-bold text-brand underline underline-offset-4" href="/network">Turn them on in Network.</a></p>
            }
        </div>
    }
    else
    {
        <div class="panel">
            <div class="space-y-3 border-b border-line p-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="relative min-w-0 flex-1 basis-64">
                        <label for="device-search" class="sr-only">Search devices</label>
                        <Icon Name="search" Class="pointer-events-none absolute left-3 top-3 text-muted" />
                        <input id="device-search" type="search" class="input pl-10" placeholder="Search by name, address or maker" autocomplete="off" spellcheck="false" @bind="_search" @bind:event="oninput" />
                    </div>
                    <p class="text-sm text-muted" role="status">@(shown.Count == devices.Count ? Fmt.Plural(devices.Count, "device", "devices") : $"{shown.Count} of {devices.Count} devices")</p>
                </div>

                <div role="toolbar" aria-label="Actions for the chosen device" class="flex flex-wrap gap-2">
                    @if (chosenPaused)
                    {
                        <button type="button" class="btn btn-primary" disabled="@none" @onclick="() => ResumeAsync(chosen!)"><Icon Name="play" />Resume</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" disabled="@none" @onclick="() => OpenPause(chosen!)"><Icon Name="pause" />Pause</button>
                    }
                    <button type="button" class="btn" disabled="@none" @onclick="() => OpenSchedule(chosen!)"><Icon Name="clock" />Off times</button>
                    <button type="button" class="btn" disabled="@none" @onclick="() => OpenLimit(chosen!)"><Icon Name="filter" />Limit sites</button>
                    <button type="button" class="btn" disabled="@none" @onclick="() => OpenRename(chosen!)"><Icon Name="edit" />Rename</button>
                    @if (chosen?.Reservation is null)
                    {
                        <button type="button" class="btn" disabled="@(none || chosen!.Address.Length == 0)" @onclick="() => FixAsync(chosen!)"><Icon Name="pin" />Fix address</button>
                    }
                    else
                    {
                        <button type="button" class="btn" disabled="@(none || chosen.BlockRule is not null)" title="@(chosen.BlockRule is not null ? "Remove the block rule first" : null)" @onclick="() => ReleaseAsync(chosen)"><Icon Name="pin" />Release address</button>
                    }
                    @if (chosen is { Address.Length: > 0 } && !_busy)
                    {
                        <a class="btn" href="/ports?device=@chosen.Address"><Icon Name="ports" />Open a port</a>
                    }
                    else
                    {
                        <button type="button" class="btn" disabled><Icon Name="ports" />Open a port</button>
                    }
                    @if (chosen?.BlockRule is not null)
                    {
                        <button type="button" class="btn" disabled="@_busy" @onclick="() => UnblockAsync(chosen)"><Icon Name="unlock" />Remove block rule</button>
                    }
                    @if (Config.ZeroTrust.Enabled && chosen is not null)
                    {
                        @if (Config.ZeroTrust.Approved.Any(a => a.Mac == chosen.Mac))
                        {
                            <button type="button" class="btn" disabled="@_busy" @onclick="() => _removeApprovalFor = chosen"><Icon Name="shield" />Remove approval</button>
                        }
                        else
                        {
                            @* Here but not approved: an address set by hand, or approval just taken away. It is cut off until approved. *@
                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => ApproveAsync(chosen)"><Icon Name="shield-check" />Approve</button>
                        }
                    }
                </div>

                <p class="text-sm text-muted" role="status">
                    @if (chosen is null)
                    {
                        <span>Choose a device from the list to use the buttons.</span>
                    }
                    else
                    {
                        <span><strong class="text-ink">@chosen.Name</strong> · @(chosen.Address.Length > 0 ? $"{chosen.Address} · " : "")@chosen.Mac</span>
                        @if (chosen.DnsName.Length > 0) { <span> · on your network as <span class="font-mono text-ink select-all">@chosen.DnsName</span></span> }
                        @if (chosen.Maker.Length > 0) { <span> · made by @chosen.Maker</span> }
                        else if (chosen.MadeUpAddress) { <span> · uses a private address, which hides who made it</span> }
                        @if (chosen.Relay is { } caught) { <span> · tried a connection-sharing service @Fmt.Plural((int)Math.Min(caught.Attempts, int.MaxValue), "time", "times"), last on @caught.LastSeen.ToLocalTime().ToString("d MMM 'at' HH:mm", CultureInfo.InvariantCulture)</span> }
                    }
                </p>
            </div>

            @if (shown.Count == 0)
            {
                <p class="p-6 text-muted">No device matches "@_search".</p>
            }
            else
            {
                <ul class="max-h-[60dvh] divide-y divide-line overflow-y-auto" aria-label="Devices">
                    @foreach (var device in shown)
                    {
                        var access = device.Access;
                        var pausedByHand = access is not null && AccessPlan.IsPausedByHand(access, now);
                        var offTime = access is null ? null : AccessPlan.CurrentOffTime(access, now.DateTime);
                        var picked = device.Mac == _selected;
                        var used = State.Usage?.Devices.FirstOrDefault(u => u.Address == device.Address && device.Address.Length > 0);
                        <li>
                            <button type="button" aria-pressed="@(picked ? "true" : "false")" @onclick="() => Choose(device)"
                                    class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 text-left hover:bg-sunk @(picked ? "bg-brand-soft hover:bg-brand-soft" : "")">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg @(picked ? "bg-brand text-on-brand" : "bg-sunk text-brand")">
                                    <Icon Name="@device.Type.ToString().ToLowerInvariant()" Class="h-6 w-6" />
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate font-bold">@device.Name</span>
                                    <span class="block truncate text-sm text-muted">@About(device)</span>
                                    <span class="mt-1 flex flex-wrap gap-1 empty:hidden">
                                        @if (pausedByHand) { <span class="tag bg-danger-soft text-danger">Paused@(access!.PausedUntil is { } until ? $" until {Clock(until)}" : "")</span> }
                                        else if (offTime is not null) { <span class="tag bg-danger-soft text-danger">Off time until @offTime.To</span> }
                                        @if (access is { OffTimes.Count: > 0 } && offTime is null) { <span class="tag bg-sunk text-ink">@Fmt.Plural(access.OffTimes.Count, "off time", "off times")</span> }
                                        @if (device.BlockRule is not null) { <span class="tag bg-danger-soft text-danger">Blocked by a rule</span> }
                                        @if (device.Limit is { } limit) { <span class="tag bg-brand-soft text-ink">@LimitPlan.Describe(limit)</span> }
                                        @if (device.Relay is not null) { <span class="tag bg-warn-soft text-warn">Tried to share your connection</span> }
                                        @if (device.Reservation is not null) { <span class="tag bg-sunk text-ink">Fixed address</span> }
                                        @if (Config.Filter.Devices.FirstOrDefault(f => f.Mac == device.Mac) is { } own) { <span class="tag bg-sunk text-ink">Filter: @Fmt.FilterLevel(own.Level)</span> }
                                    </span>
                                </span>
                                <span class="hidden w-32 shrink-0 text-sm sm:block @(device.Online ? "" : "text-muted")">@(device.Online ? device.Address : "Not connected")</span>
                                <span class="w-24 shrink-0 whitespace-nowrap text-right text-sm">
                                    @if (used is not null)
                                    {
                                        <span class="flex items-center justify-end gap-1"><Icon Name="down" Class="h-4 w-4 text-down" /><span class="sr-only">Received</span>@Fmt.Bytes(used.DownBytes)</span>
                                        <span class="flex items-center justify-end gap-1"><Icon Name="up" Class="h-4 w-4 text-up" /><span class="sr-only">Sent</span>@Fmt.Bytes(used.UpBytes)</span>
                                    }
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="mt-3 max-w-2xl space-y-1 text-sm text-muted">
            <p>The amounts are what each device used over the last 24 hours. A paused device loses the internet within seconds, but still reaches other devices at home and this page.</p>
            <p>Devices are recognised by their hardware address. A phone set to change that address looks like a new device and is not paused.</p>
        </div>
    }
</div>

<Modal Open="_limitFor is not null" Title="@($"Limit {_limitFor?.Name} to chosen sites")" OnClose="() => _limitFor = null">
    <form class="space-y-4" @onsubmit="SaveLimitAsync">
        <p class="text-muted">This device will reach only what you choose here. Everything else it tries, in or out, is refused. Good for a TV box that is only for watching.</p>
        <label class="panel flex cursor-pointer items-start gap-3 p-3 @(_limitYouTube ? "border-brand bg-brand-soft" : "")">
            <input type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-brand" @bind="_limitYouTube" />
            <span>
                <span class="font-bold">YouTube</span>
                <span class="block text-muted">With the Google services its apps need to start and sign in.</span>
            </span>
        </label>
        <div>
            <label for="limit-sites" class="field-label">Other sites to allow</label>
            <textarea id="limit-sites" class="input min-h-24 py-2" rows="3" autocapitalize="none" spellcheck="false" placeholder="netflix.com" @bind="_limitSites"></textarea>
            <p class="field-hint">One per line. A name covers everything under it. Big services often use several names, so an app may need a few added before it works.</p>
        </div>
        <p class="field-hint">Sites that share servers with an allowed one can also be reached; with YouTube that means Google's other sites. Open ports pointing at this device stop working.</p>
        <Problems Issues="Issues" />
        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" disabled="@_busy">Save limit</button>
            @if (_limitFor?.Limit is not null)
            {
                <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="RemoveLimitAsync">Remove limit</button>
            }
            <button type="button" class="btn" @onclick="() => _limitFor = null">Cancel</button>
        </div>
    </form>
</Modal>

<Modal Open="_renameFor is not null" Title="@($"Rename {_renameFor?.Name}")" OnClose="() => _renameFor = null">
    <form class="space-y-4" @onsubmit="RenameAsync">
        <div>
            <label for="device-name" class="field-label">Name</label>
            <input id="device-name" class="input" maxlength="@DeviceName.MaxLength" autocomplete="off" @bind="_newName" />
            <p class="field-hint">Shown wherever this device is listed. Leave it empty to go back to "@_renameFor?.OwnName".</p>
        </div>
        <Problems Issues="Issues" />
        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" disabled="@_busy">Save name</button>
            <button type="button" class="btn" @onclick="() => _renameFor = null">Cancel</button>
        </div>
    </form>
</Modal>

<Modal Open="_pauseFor is not null" Title="@($"Pause the internet for {_pauseFor?.Name}")" OnClose="() => _pauseFor = null">
    <p class="text-muted">It comes back by itself when the time is up. You can resume it earlier from this page.</p>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <button type="button" class="btn" disabled="@_busy" @onclick="() => PauseAsync(TimeSpan.FromMinutes(30))">For 30 minutes</button>
        <button type="button" class="btn" disabled="@_busy" @onclick="() => PauseAsync(TimeSpan.FromHours(1))">For 1 hour</button>
        <button type="button" class="btn" disabled="@_busy" @onclick="() => PauseAsync(TimeSpan.FromHours(2))">For 2 hours</button>
        <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="() => PauseAsync(null)">Until I resume it</button>
    </div>
    <div class="mt-4"><Problems Issues="Issues" /></div>
</Modal>

<Modal Open="_scheduleFor is not null" Title="@($"Off times for {_scheduleFor?.Name}")" OnClose="() => _scheduleFor = null">
    <p class="text-muted">The internet is off for this device during these times, every week. The firewall's clock says <strong class="text-ink">@DateTime.Now.ToString("dddd HH:mm", CultureInfo.InvariantCulture)</strong>.</p>

    @if (_offTimes.Count == 0)
    {
        <p class="mt-4 rounded-md bg-sunk p-3 text-muted">No off times yet. Add one below.</p>
    }
    else
    {
        <ul class="mt-4 divide-y divide-line rounded-md border border-line">
            @foreach (var off in _offTimes)
            {
                <li class="flex items-center justify-between gap-3 py-2 pl-3 pr-1">
                    <span>
                        <span class="font-bold">@off.From to @off.To@(Overnight(off) ? " the next morning" : "")</span>
                        <span class="block text-sm text-muted">@DayText(off.Days)</span>
                    </span>
                    <button type="button" class="btn btn-quiet" aria-label="@($"Remove {off.From} to {off.To}, {DayText(off.Days)}")" @onclick="() => _offTimes.Remove(off)">Remove</button>
                </li>
            }
        </ul>
    }

    <form class="mt-5 space-y-4 border-t border-line pt-4" @onsubmit="AddOffTime">
        <fieldset>
            <legend class="field-label">Add an off time on these days</legend>
            <div class="flex flex-wrap gap-2">
                @foreach (var day in Week)
                {
                    var on = _days.Contains(day);
                    <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border px-3 @(on ? "border-brand bg-brand-soft" : "border-line")">
                        <input type="checkbox" class="h-4 w-4 accent-brand" checked="@on" @onchange="() => Toggle(day)" />
                        <span>@ShortDay(day)</span>
                    </label>
                }
            </div>
            <div class="mt-2 flex flex-wrap gap-1">
                <button type="button" class="btn btn-quiet" @onclick="() => _days = [.. Week]">Every day</button>
                <button type="button" class="btn btn-quiet" @onclick="() => _days = [DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday]">School nights</button>
                <button type="button" class="btn btn-quiet" @onclick="() => _days = [DayOfWeek.Friday, DayOfWeek.Saturday]">Weekend nights</button>
            </div>
        </fieldset>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="off-from" class="field-label">Internet goes off at</label>
                <input id="off-from" class="input" type="time" @bind="_from" />
            </div>
            <div>
                <label for="off-to" class="field-label">And comes back at</label>
                <input id="off-to" class="input" type="time" @bind="_to" />
            </div>
        </div>
        <p class="field-hint">If it comes back earlier than it goes off, the off time runs through the night into the next morning.</p>
        <button type="submit" class="btn">Add this off time</button>
    </form>

    <div class="mt-5 space-y-4 border-t border-line pt-4">
        <Problems Issues="Issues" />
        <div class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveScheduleAsync">Save off times</button>
            <button type="button" class="btn" @onclick="() => _scheduleFor = null">Cancel</button>
        </div>
    </div>
</Modal>

<Modal Open="_removeApprovalFor is not null" Title="@($"Remove approval for {_removeApprovalFor?.Name}")" OnClose="() => _removeApprovalFor = null">
    <p>It loses the internet, your other devices and this firewall's page until it is approved again. If it asks for an address, it is moved into the holding zone.</p>
    <p class="mt-3 rounded-md border border-warn bg-warn-soft p-3">If this is the device you are using now, you will lose this page too. Like every change, it is undone after a minute unless this page can still reach the firewall.</p>
    <div class="mt-5 flex flex-wrap gap-2">
        <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="RemoveApprovalAsync">Remove approval</button>
        <button type="button" class="btn btn-quiet" @onclick="() => _removeApprovalFor = null">Keep it approved</button>
    </div>
</Modal>

@code {
    private Device? _removeApprovalFor;

    private async Task ApproveAsync(Device device)
    {
        _busy = true;
        Issues = await State.ChangeApprovalAsync(ApprovalAction.Approve, device.Mac, device.Renamed ? device.Name : "");
        _busy = false;
    }

    private async Task RemoveApprovalAsync()
    {
        var device = _removeApprovalFor!;
        _busy = true;
        Issues = await State.ChangeApprovalAsync(ApprovalAction.Remove, device.Mac);
        _busy = false;
        _removeApprovalFor = null;
    }

    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private bool _busy;
    private string _search = "";
    private string? _selected;

    private void Choose(Device device)
    {
        Issues = [];
        _selected = _selected == device.Mac ? null : device.Mac;
    }

    /// <summary>One short line saying what the device is: its kind and maker when known, otherwise its hardware address.</summary>
    private static string About(Device device) =>
        device.Maker.Length > 0 ? (device.Type == DeviceType.Unknown ? device.Maker : $"{DeviceKind.Label(device.Type)} · {device.Maker}")
        : device.Type != DeviceType.Unknown ? $"{DeviceKind.Label(device.Type)} · {device.Mac}"
        : device.MadeUpAddress ? $"Private address · {device.Mac}"
        : device.Mac;

    private bool Matches(Device device)
    {
        var words = _search.Split(' ', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return true;
        var text = $"{device.Name} {device.OwnName} {device.Address} {device.Mac} {device.Maker} {DeviceKind.Label(device.Type)}";
        return words.All(word => text.Contains(word, StringComparison.OrdinalIgnoreCase));
    }

    private Device? _pauseFor, _scheduleFor, _renameFor;
    private string _newName = "";

    private void OpenRename(Device device)
    {
        Issues = [];
        _newName = device.Renamed ? device.Name : "";
        _renameFor = device;
    }

    private async Task RenameAsync()
    {
        if (_renameFor is not { } device) return;
        _busy = true;
        Issues = await State.RenameAsync(device.Mac, _newName.Trim());
        _busy = false;
        if (Issues.Count == 0) _renameFor = null;
    }
    private List<OffTime> _offTimes = [];
    private List<DayOfWeek> _days = [];
    private TimeOnly _from = new(21, 0), _to = new(7, 0);
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _ = WatchAsync(_cts.Token);
    }

    // Pauses end and off times begin without anyone saving anything, and new devices join, so look again regularly.
    private async Task WatchAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            // Once straight away, so the amounts each device used are there when the page opens.
            do
            {
                await State.RefreshStatusAsync();
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) { }
    }

    private static string Clock(DateTimeOffset time)
    {
        var local = time.ToLocalTime();
        return local.ToString(local.Date == DateTimeOffset.Now.Date ? "HH:mm" : "dddd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string ShortDay(DayOfWeek day) => day.ToString()[..3];

    private static string DayText(List<DayOfWeek> days) =>
        days.Count == 7 ? "Every day" : string.Join(", ", Week.Where(days.Contains).Select(ShortDay));

    private static bool Overnight(OffTime off) =>
        AccessPlan.TryParseTime(off.From, out var from) && AccessPlan.TryParseTime(off.To, out var to) && to <= from;

    private async Task RunAsync(Action<FirewallConfig> change)
    {
        _busy = true;
        await SaveAsync(change);
        _busy = false;
    }

    /// <summary>Changes one device's pause or off times. Returns true when the firewall accepted it.</summary>
    private async Task<bool> SaveAccessAsync(Device device, Action<DeviceAccess> change)
    {
        _busy = true;
        Issues = await State.SaveAccessAsync(list =>
        {
            var now = DateTimeOffset.UtcNow;
            // Timed pauses that have run out are only clutter by now.
            foreach (var done in list.Where(a => a.Paused && a.PausedUntil <= now)) (done.Paused, done.PausedUntil) = (false, null);
            var entry = list.FirstOrDefault(a => a.Mac == device.Mac);
            if (entry is null) list.Add(entry = new DeviceAccess { Mac = device.Mac, Name = device.SafeName });
            change(entry);
            list.RemoveAll(a => !a.Paused && a.OffTimes.Count == 0);
        });
        _busy = false;
        return Issues.Count == 0;
    }

    private Device? _limitFor;
    private bool _limitYouTube;
    private string _limitSites = "";

    private void OpenLimit(Device device)
    {
        Issues = [];
        _limitYouTube = device.Limit?.YouTube ?? true;
        _limitSites = string.Join('\n', device.Limit?.Sites ?? []);
        _limitFor = device;
    }

    private async Task SaveLimitAsync()
    {
        if (_limitFor is not { } device) return;
        var sites = new List<string>();
        foreach (var line in _limitSites.Split(['\n', ',', ' '], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        {
            if (!SiteName.TryNormalize(line, out var site))
            {
                Issues = [new("", $"\"{line}\" is not a site name. Use a name like example.com.")];
                return;
            }
            if (!sites.Contains(site)) sites.Add(site);
        }
        _busy = true;
        var saved = await SaveAsync(c =>
        {
            c.Limits.RemoveAll(l => l.Mac == device.Mac);
            c.Limits.Add(new DeviceLimit { Mac = device.Mac, Name = device.SafeName, YouTube = _limitYouTube, Sites = sites });
        });
        _busy = false;
        if (saved) _limitFor = null;
    }

    private async Task RemoveLimitAsync()
    {
        if (_limitFor is not { } device) return;
        _busy = true;
        var saved = await SaveAsync(c => c.Limits.RemoveAll(l => l.Mac == device.Mac));
        _busy = false;
        if (saved) _limitFor = null;
    }

    private void OpenPause(Device device)
    {
        Issues = [];
        _pauseFor = device;
    }

    private async Task PauseAsync(TimeSpan? length)
    {
        if (_pauseFor is not { } device) return;
        if (await SaveAccessAsync(device, a => (a.Paused, a.PausedUntil) = (true, length is { } l ? DateTimeOffset.UtcNow + l : null)))
            _pauseFor = null;
    }

    private Task ResumeAsync(Device device) => SaveAccessAsync(device, a => (a.Paused, a.PausedUntil) = (false, null));

    private void OpenSchedule(Device device)
    {
        Issues = [];
        _offTimes = [.. (device.Access?.OffTimes ?? []).Select(o => new OffTime { Id = o.Id, Days = [.. o.Days], From = o.From, To = o.To })];
        _days = [];
        (_from, _to) = (new(21, 0), new(7, 0));
        _scheduleFor = device;
    }

    private void Toggle(DayOfWeek day)
    {
        if (!_days.Remove(day)) _days.Add(day);
    }

    private void AddOffTime()
    {
        if (_days.Count == 0)
        {
            Issues = [new("", "Tick at least one day for the off time.")];
            return;
        }
        if (_from == _to)
        {
            Issues = [new("", "The internet can't go off and come back at the same minute. Change one of the times.")];
            return;
        }
        Issues = [];
        _offTimes.Add(new OffTime
        {
            Days = [.. Week.Where(_days.Contains)],
            From = _from.ToString("HH:mm", CultureInfo.InvariantCulture),
            To = _to.ToString("HH:mm", CultureInfo.InvariantCulture),
        });
        _days = [];
    }

    private async Task SaveScheduleAsync()
    {
        if (_scheduleFor is not { } device) return;
        // Days ticked but not yet added are almost certainly meant to be saved too.
        if (_days.Count > 0)
        {
            AddOffTime();
            if (Issues.Count > 0) return;
        }
        if (await SaveAccessAsync(device, a => a.OffTimes = [.. _offTimes])) _scheduleFor = null;
    }

    private static void EnsureFixed(FirewallConfig c, Device device)
    {
        if (c.Dhcp.Reservations.All(r => r.Mac != device.Mac))
            c.Dhcp.Reservations.Add(new Reservation { Name = device.SafeName, Mac = device.Mac, Address = device.Address });
    }

    private Task FixAsync(Device device) => RunAsync(c => EnsureFixed(c, device));

    private Task ReleaseAsync(Device device) => RunAsync(c => c.Dhcp.Reservations.RemoveAll(r => r.Mac == device.Mac));

    private Task UnblockAsync(Device device) => RunAsync(c => c.Rules.RemoveAll(r => FirewallState.IsDeviceBlock(r, device.Address)));

    public override void Dispose()
    {
        _cts.Cancel();
        base.Dispose();
    }
}
