<Project Sdk="Microsoft.NET.Sdk">

  <!-- How the companion app reaches a real firewall: the pairing link, the pinned HTTPS connection, and
       RemoteBackend, which gives the shared screens the same interfaces the web interface gives them.
       Plain .NET with no MAUI in it, so it is tested on any machine against a running web interface. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Palisade.Core\Palisade.Core.csproj" />
    <ProjectReference Include="..\Palisade.UI\Palisade.UI.csproj" />
  </ItemGroup>

</Project>
