@page "/share"
@inherits StatePage
@inject ActiveFirewall Active

<PageTitle>Block or allow a site · Palisade</PageTitle>

<h1 class="text-3xl font-extrabold" tabindex="-1">Block or allow a site</h1>

@if (_site is null)
{
    <p class="mt-3 text-lg">There is no site name in what was shared.</p>
    <p class="mt-2 text-muted">Share the page from your browser, or add sites by hand on the content filter page.</p>
    <a href="/filter" class="btn btn-primary mt-6">Open the content filter</a>
}
else
{
    <p class="mt-3 text-muted">From what you shared:</p>
    <p class="mt-1 break-all text-2xl font-bold">@_site</p>
    <p class="mt-2">@Where</p>

    <Problems Issues="Issues" />

    <div class="mt-6 flex flex-col gap-3">
        @if (!Blocked)
        {
            <button type="button" class="btn btn-danger justify-center py-3" disabled="@_busy" @onclick="() => SaveAsync(block: true)">
                Block @_site for everyone
            </button>
        }
        @if (!Allowed)
        {
            <button type="button" class="btn btn-quiet justify-center py-3" disabled="@_busy" @onclick="() => SaveAsync(block: false)">
                Always allow @_site
            </button>
        }
        <a href="/filter" class="btn btn-quiet justify-center">Open the content filter</a>
    </div>
    <p class="mt-6 text-sm text-muted">Blocking covers everything under the name, such as www.@_site. A site goes on one list at a time: choosing one takes it off the other.</p>
}

@code {
    /// <summary>What another app shared, usually the address of a page.</summary>
    [SupplyParameterFromQuery] public string? Text { get; set; }

    private string? _site;
    private bool _busy;

    private bool Blocked => Config.Filter.BlockedSites.Contains(_site!);
    private bool Allowed => Config.Filter.AllowedSites.Contains(_site!);

    private string Where => Blocked ? $"It is blocked for everyone on {Active.Name.ToLowerInvariant()}."
        : Allowed ? "It always opens, whatever a device's filter level."
        : "It is on neither list now: the filter level decides.";

    protected override void OnParametersSet() => _site = IncomingLinks.FindSite(Text);

    private async Task SaveAsync(bool block)
    {
        _busy = true;
        var site = _site!;
        await base.SaveAsync(c =>
        {
            c.Filter.BlockedSites.Remove(site);
            c.Filter.AllowedSites.Remove(site);
            (block ? c.Filter.BlockedSites : c.Filter.AllowedSites).Add(site);
        });
        _busy = false;
    }
}
