[Unit]
Description=Palisade firewall agent (applies network configuration)
After=network.target nftables.service
Wants=nftables.service

[Service]
Type=simple
ExecStart=/opt/palisade/agent/Palisade.Agent
WorkingDirectory=/opt/palisade/agent
User=root
RuntimeDirectory=palisade
RuntimeDirectoryMode=0755
StateDirectory=palisade
Environment=DOTNET_ENVIRONMENT=Production
Restart=on-failure
# The agent brings network ports up, which starts long-lived helpers (the DHCP client, the Wi-Fi client).
# They must outlive a restart or upgrade of the agent, or the internet port loses its address.
KillMode=process
RestartSec=3

[Install]
WantedBy=multi-user.target
